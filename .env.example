# MyBlog 环境变量模板（公网部署请复制为 .env 并替换全部默认密码与密钥）

MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=replace-with-strong-mysql-password

REDIS_PORT=16379
REDIS_PASSWORD=replace-with-strong-redis-password

BACKEND_PORT=8000
WEB_PORT=9123

# JWT 签名密钥（须至少 32 字节 UTF-8 随机字符串）
JWT_SECRET_KEY=replace-with-at-least-32-chars-random-jwt-secret-key

# 可选：静态引导 MCP API Key（留空则完全使用后台生成的 blog_mcp_token 密钥）
BLOG_MCP_BOOTSTRAP_TOKEN=
